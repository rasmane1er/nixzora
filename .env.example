# Copy to .env at the repo root and to apps/api/.env for local development.
# Values below match docker-compose.yml. Never commit real secrets.

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://nixzora:nixzora_dev_password@localhost:5433/nixzora?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug
WEB_APP_URL=http://localhost:3000

# Identity. Without these, development uses temporary keys that reset on every restart.
# Generate real values with: pnpm --filter @nixzora/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MFA_ENCRYPTION_KEY=
PASSWORD_BREACH_CHECK=false

# Sign in with Google / Apple. Public client ids (not secrets); leave blank to hide the buttons.
# Setup: docs/runbooks/sign-in-with-google-apple.md
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_SERVICES_ID=

# Product images. Development stores files on disk under apps/api/storage (git-ignored).
# Production uses S3 + CloudFront: STORAGE_DRIVER=s3, S3_BUCKET, S3_REGION, ASSETS_BASE_URL.
API_PUBLIC_URL=http://localhost:4000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Signs one-time upload links. Optional in development (a temporary value is used).
# MEDIA_SIGNING_SECRET=

# Checkout. "fake" shows test Pay buttons (no card needed). For the real Stripe form, set
# PAYMENTS_PROVIDER=stripe and the three test keys from dashboard.stripe.com (test mode),
# then forward webhooks: stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe
PAYMENTS_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
SHIPPING_FLAT_CENTS=999
FREE_SHIPPING_THRESHOLD_CENTS=9900
# Sales tax by state, in basis points (600 = 6%). Only where the business is registered.
TAX_RATES_BPS=MD:600
# Signs guest order links in emails. Required in production (any long random string).
# ORDER_LINK_SECRET=

# Shipping labels: "fake" prints test labels; "easypost" buys postage (EASYPOST_API_KEY);
# "none" turns label buying off (staff type tracking numbers).
SHIPPING_PROVIDER=fake
# EASYPOST_API_KEY=
# EASYPOST_WEBHOOK_SECRET=

# Email: "log" prints emails to the API console; "ses" sends with Amazon SES.
MAIL_DRIVER=log
MAIL_FROM=NIXZORA <orders@nixzora.local>

# Push notifications to the mobile app: "log" prints them; "expo" sends via Expo's push service.
PUSH_DRIVER=log
# EXPO_ACCESS_TOKEN=

# Tracing (optional). Run `pnpm obs:up`, uncomment, then open http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nixzora-api

# --- Storefront (apps/storefront) and Ops Center (apps/admin) ---
# Both call the API from their servers. Create your first admin with:
#   pnpm --filter @nixzora/api admin:create you@example.com
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Universal links / App Links (optional): storefront URLs that open in the mobile app.
# IOS_APP_IDS=ABCDE12345.com.nixzora.shop
# ANDROID_PACKAGE=com.nixzora.shop
# ANDROID_CERT_FINGERPRINTS=AA:BB:...

# --- Mobile app (apps/mobile/.env) ---
# The phone must reach the API: use your computer's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3000

# ── AI layer (ADR-0009) ──
# "local" drivers are free and work offline. To use real models, set the driver and its key.
EMBEDDINGS_DRIVER=local
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4-lite
AI_DRIVER=local
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5
AI_DAILY_BUDGET_CENTS=200
SEARCH_MODE=hybrid

# ── Client identity (production) ──
# TRUST_PROXY_HOPS=1
# INTERNAL_API_KEY=   (same value in the storefront and Ops Center)
