// NIXZORA domain model — Phase 0 draft.
// Covers identity, catalog, inventory, orders and payments (Phases 1–3)
// plus the audit log and transactional outbox used by every module.
// Reviews, shipments, promotions and sellers arrive in later migrations.
//
// Conventions
// - Primary keys are UUIDv7 (time-ordered) unless noted.
// - Tables and columns are snake_case in PostgreSQL.
// - Money is always integer minor units (`*_cents`) plus a currency code.
// - Each module owns its tables; other modules go through its service.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Identity ───────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at")
  passwordHash    String?    @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  status          UserStatus @default(ACTIVE)
  /// Deals and new arrivals by email: off until the customer opts in.
  marketingEmails Boolean    @default(false) @map("marketing_emails")
  /// When the customer agreed to the Terms of Service and Privacy Policy at sign-up.
  termsAcceptedAt DateTime?  @map("terms_accepted_at")
  /// An email after delivery asking for a review.
  reviewRequests  Boolean    @default(true) @map("review_requests")
  /// Profile photo (an uploaded image's storage key).
  avatarKey       String?    @map("avatar_key")
  /// Language for the website, the app, emails and push: "en", "fr" or "es".
  language        String     @default("en")
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  /// TOTP secret, encrypted at the application layer (AES-256-GCM).
  mfaSecretEnc    String?    @map("mfa_secret_enc")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions           Session[]
  roles              UserRole[]
  addresses          Address[]
  orders             Order[]
  verificationTokens VerificationToken[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  reviews            Review[]
  wishlist           WishlistItem[]
  notes              CustomerNote[]
  pushDevices        PushDevice[]
  identities         UserIdentity[]
  productEvents      ProductEvent[]
  sellerMembership   SellerMember?
  supportRequests    SupportRequest[]
  sellerApplication  SellerApplicationDraft?
  passkeys           Passkey[]
  deviceSignIns      DeviceSignIn[]
  riskReviews        RiskAssessment[]        @relation("RiskReviewer")

  @@map("users")
}

/// A passkey (WebAuthn credential): sign in with Touch ID, Face ID, Windows Hello, a phone's
/// fingerprint or a security key, instead of a password. See ADR-0019.
model Passkey {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// The authenticator's credential id (base64url).
  credentialId String    @unique @map("credential_id")
  /// COSE public key; the private key never leaves the person's device.
  publicKey    Bytes     @map("public_key")
  /// Signature counter, to spot cloned authenticators (0 when the authenticator does not count).
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// "singleDevice" or "multiDevice" (synced, e.g. iCloud Keychain or Google Password Manager).
  deviceType   String    @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  /// Shown in the account: "MacBook Chrome", "iPhone"... editable by the person.
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// "Sign in with Face ID / fingerprint" in the app: a device secret kept in the phone's secure
/// storage behind the biometric check. Rotated on every use; revoked from the account page.
model DeviceSignIn {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the current device secret.
  secretHash String    @unique @map("secret_hash")
  deviceName String    @map("device_name")
  platform   String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sign_ins")
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

/// A Google or Apple account linked to a user (sign in with Google / Apple).
model UserIdentity {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  provider   IdentityProvider
  /// The provider's stable user id (the ID token's "sub").
  subject    String
  /// Email the provider reported when the account was linked (Apple may give a relay address).
  email      String?
  createdAt  DateTime         @default(now()) @map("created_at")
  lastUsedAt DateTime         @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id                       String    @id @default(uuid(7)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh token; rotated on every refresh.
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  /// SHA-256 of the token it replaced. Presenting it again means the token was stolen.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  /// Set when this session passed a second factor (TOTP or recovery code).
  mfaVerifiedAt            DateTime? @map("mfa_verified_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  deviceName               String?   @map("device_name")
  createdAt                DateTime  @default(now()) @map("created_at")
  lastUsedAt               DateTime  @default(now()) @map("last_used_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use, expiring tokens sent by email. Only the SHA-256 hash is stored.
model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// One-time MFA recovery codes. Only the SHA-256 hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  key         String           @unique
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// e.g. "catalog.product.write", "orders.refund"
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Address {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  label             String?
  fullName          String   @map("full_name")
  line1             String
  line2             String?
  city              String
  region            String
  postalCode        String   @map("postal_code")
  /// ISO 3166-1 alpha-2
  country           String   @db.Char(2)
  phone             String?
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────── Catalog ───────────────────────────

enum ProductStatus {
  DRAFT
  /// A seller's listing waiting for staff review (p7-03).
  PENDING_REVIEW
  ACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  slug        String     @unique
  name        String
  description String?
  position    Int        @default(0)
  isActive    Boolean    @default(true) @map("is_active")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid(7)) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]

  @@map("brands")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  slug        String        @unique
  title       String
  description String
  status      ProductStatus @default(DRAFT)
  categoryId  String        @map("category_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  /// Normalized specs, e.g. {"ram_gb": 32, "storage_gb": 1024, "battery_hours": 18}
  attributes  Json          @default("{}")
  /// Marketplace seller; null means NIXZORA sells it (first party).
  sellerId    String?       @map("seller_id") @db.Uuid
  /// Why staff sent a seller's listing back, shown to the seller.
  reviewNote  String?       @map("review_note")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  seller        Seller?           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category          @relation(fields: [categoryId], references: [id])
  brand         Brand?            @relation(fields: [brandId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  reviews       Review[]
  wishlist      WishlistItem[]
  events        ProductEvent[]
  reviewInsight ReviewInsight?
  searchDoc     ProductSearchDoc?

  @@index([categoryId, status])
  @@index([sellerId, status])
  @@map("products")
}

model ProductImage {
  id         String @id @default(uuid(7)) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  /// S3 object key, served through CloudFront
  storageKey String @map("storage_key")
  alt        String
  position   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique
  /// GTIN printed on the box (EAN-13, UPC-A, EAN-8 or GTIN-14), used by the app's scanner.
  barcode        String?  @unique
  title          String
  /// e.g. {"memory": "32GB", "color": "Graphite"}
  options        Json     @default("{}")
  priceCents     Int      @map("price_cents")
  compareAtCents Int?     @map("compare_at_cents")
  currency       String   @default("USD") @db.Char(3)
  weightGrams    Int?     @map("weight_grams")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  InventoryItem?
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────── Inventory ───────────────────────────

model InventoryItem {
  variantId String   @id @map("variant_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  /// Units held by unpaid checkouts; available = on_hand - reserved
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@map("inventory_items")
}

model InventoryReservation {
  id        String   @id @default(uuid(7)) @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  quantity  Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  inventory InventoryItem @relation(fields: [variantId], references: [variantId], onDelete: Cascade)

  @@index([variantId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

// ─────────────────────────── Orders ───────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  /// Customer-facing number, e.g. NX-10482
  number          String      @unique
  userId          String?     @map("user_id") @db.Uuid
  email           String
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @default("USD") @db.Char(3)
  subtotalCents   Int         @map("subtotal_cents")
  shippingCents   Int         @default(0) @map("shipping_cents")
  taxCents        Int         @default(0) @map("tax_cents")
  discountCents   Int         @default(0) @map("discount_cents")
  couponCode      String?     @map("coupon_code")
  /// Language the customer checked out in ("en", "fr", "es"): emails to guests use it.
  language        String      @default("en")
  /// Total refunded so far (partial refunds and returns).
  refundedCents   Int         @default(0) @map("refunded_cents")
  /// Postage paid for the label, and where to print it.
  labelUrl        String?     @map("label_url")
  postageCents    Int?        @map("postage_cents")
  totalCents      Int         @map("total_cents")
  /// Address snapshots: orders never change when an address book entry does.
  shippingAddress Json        @map("shipping_address")
  billingAddress  Json?       @map("billing_address")
  trackingCarrier String?     @map("tracking_carrier")
  trackingNumber  String?     @map("tracking_number")
  cancelReason    String?     @map("cancel_reason")
  placedAt        DateTime?   @map("placed_at")
  fulfillingAt    DateTime?   @map("fulfilling_at")
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  /// Fraud review (ADR-0024): paid but not to be shipped until staff clear it.
  riskHold        Boolean     @default(false) @map("risk_hold")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  returns         ReturnRequest[]
  sellerOrders    SellerOrder[]
  riskAssessments RiskAssessment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  /// Snapshots of what was bought, at the price paid
  productTitle   String  @map("product_title")
  variantTitle   String  @map("variant_title")
  sku            String
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  totalCents     Int     @map("total_cents")
  /// Marketplace seller of this line at the time of purchase; null for NIXZORA's own items.
  sellerId       String? @map("seller_id") @db.Uuid

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller  Seller?         @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

// ─────────────────────────── Payments ───────────────────────────

enum PaymentProvider {
  STRIPE
  /// Development and tests only: payments confirmed without a card.
  FAKE
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  /// e.g. Stripe PaymentIntent id (pi_...). No card data is ever stored.
  providerPaymentId String          @unique @map("provider_payment_id")
  status            PaymentStatus
  amountCents       Int             @map("amount_cents")
  currency          String          @db.Char(3)
  /// The card holder disputed the charge (chargeback).
  disputedAt        DateTime?       @map("disputed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String   @id @default(uuid(7)) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  providerRefundId String   @unique @map("provider_refund_id")
  amountCents      Int      @map("amount_cents")
  reason           String?
  status           String
  createdAt        DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

/// Webhook idempotency: an event id is processed at most once.
model ProcessedWebhookEvent {
  id         String          @id
  provider   PaymentProvider
  receivedAt DateTime        @default(now()) @map("received_at")

  @@map("processed_webhook_events")
}

// ─────────────────────────── Platform ───────────────────────────

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

/// Append-only. UPDATE and DELETE are blocked by a database trigger.
/// Partitioned by month on created_at (ADR-0022): primary key (id, created_at) in the database,
/// partitions in the "partitions" schema, structure owned by migrations (external table).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// e.g. "auth.login.succeeded", "orders.refund.created"
  action     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same transaction as the change,
/// then published by a worker (BullMQ now, Kafka in Phase 8).
/// Partitioned by month on created_at (ADR-0022): primary key (id, created_at) in the database,
/// partitions in the "partitions" schema, structure owned by migrations (external table).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  type          String
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /// When the event reached Kafka (ADR-0020); separate from in-process delivery (publishedAt).
  streamedAt    DateTime? @map("streamed_at")

  @@index([publishedAt, createdAt])
  @@index([streamedAt, createdAt])
  @@map("outbox_events")
}

// ───────────── Phase 4: customers, reviews, promotions, returns ─────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One review per customer per product. Visible only after moderation.
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  /// 1 to 5 stars
  rating           Int
  title            String
  body             String
  status           ReviewStatus @default(PENDING)
  /// The author has a paid order containing this product.
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?    @map("moderated_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlist_items")
}

enum CouponType {
  /// value is in basis points (1500 = 15% off)
  PERCENT
  /// value is in cents (1000 = $10 off)
  FIXED
}

model Coupon {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Upper-case, e.g. WELCOME10
  code             String     @unique
  description      String?
  type             CouponType
  value            Int
  minSubtotalCents Int        @default(0) @map("min_subtotal_cents")
  maxRedemptions   Int?       @map("max_redemptions")
  redemptionCount  Int        @default(0) @map("redemption_count")
  startsAt         DateTime?  @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  isActive         Boolean    @default(true) @map("is_active")
  /// Listed in customers' accounts (Coupons & promotions). Others work only for those given the code.
  isPublic         Boolean    @default(false) @map("is_public")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("coupons")
}

enum SupportTopic {
  ORDER
  DELIVERY
  RETURN
  PAYMENT
  ACCOUNT
  PRODUCT
  PROBLEM
  OTHER
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A message to customer support (Help → Contact us, or Report a problem).
model SupportRequest {
  id          String        @id @default(uuid(7)) @db.Uuid
  /// Short reference the customer can quote, e.g. "S-7KQ4M2".
  reference   String        @unique
  userId      String?       @map("user_id") @db.Uuid
  email       String
  name        String?
  topic       SupportTopic
  orderNumber String?       @map("order_number")
  subject     String
  message     String
  status      SupportStatus @default(OPEN)
  staffReply  String?       @map("staff_reply")
  /// Page the customer was on when reporting a problem.
  pageUrl     String?       @map("page_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  answeredAt  DateTime?     @map("answered_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_requests")
}

/// Private notes staff keep about a customer (support history).
model CustomerNote {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Staff author; kept as plain values so notes survive staff account changes.
  authorId    String?  @map("author_id") @db.Uuid
  authorEmail String   @map("author_email")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("customer_notes")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  status       ReturnStatus @default(REQUESTED)
  reason       String
  /// [{ "orderItemId": "...", "quantity": 1 }]
  items        Json
  customerNote String?      @map("customer_note")
  staffNote    String?      @map("staff_note")
  refundCents  Int?         @map("refund_cents")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  resolvedAt   DateTime?    @map("resolved_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("return_requests")
}

// ─────────────────────────── Mobile ───────────────────────────

enum DevicePlatform {
  IOS
  ANDROID
}

/// An installed copy of the mobile app that may receive push notifications.
model PushDevice {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  /// Expo push token, e.g. ExponentPushToken[...]. One device belongs to one account at a time.
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// ─────────────────────────── Intelligence (Phase 6, ADR-0009) ───────────────────────────

/// One searchable document per product: weighted text for full-text search and an embedding
/// for semantic search. Written by the search indexer with raw SQL (vector casts).
model ProductSearchDoc {
  productId      String                      @id @map("product_id") @db.Uuid
  titleText      String                      @map("title_text")
  facetsText     String                      @map("facets_text")
  bodyText       String                      @map("body_text")
  contentHash    String                      @map("content_hash")
  embeddingModel String                      @map("embedding_model")
  embedding      Unsupported("vector(512)")?
  /// Generated column: weighted tsvector of the three text parts (see the migration).
  document       Unsupported("tsvector")?
  updatedAt      DateTime                    @default(now()) @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_search_docs")
}

/// Every model call (paid or local), for the AI operations panel and the daily spend cap.
model AiRequest {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// e.g. "assistant", "embeddings", "enrichment"
  feature      String
  driver       String
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// Estimated cost in millionths of a US dollar.
  costMicros   Int      @default(0) @map("cost_micros")
  latencyMs    Int      @map("latency_ms")
  /// Assistant answers: every product it named was in the retrieved set.
  grounded     Boolean?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([feature, createdAt])
  @@map("ai_requests")
}

enum ProductEventType {
  VIEW
}

/// Shopping signals for recommendations (p6-08): who looked at what, and when. Guests are a
/// random visitor id from the app or browser, never an IP address. Kept for 180 days.
/// Partitioned by month on created_at (ADR-0022): primary key (id, created_at) in the database,
/// partitions in the "partitions" schema, structure owned by migrations (external table).
model ProductEvent {
  id        String           @id @default(uuid(7)) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  visitorId String?          @map("visitor_id")
  type      ProductEventType
  createdAt DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([productId, createdAt])
  @@map("product_events")
}

/// "What customers say" (p6-04): computed from approved reviews, regenerated when they change.
model ReviewInsight {
  productId     String   @id @map("product_id") @db.Uuid
  summary       String
  /// { fr, es }: the model's summary in other languages (none for template rows, which are
  /// translated when read). Readers fall back to the translated template.
  summaries     Json     @default("{}")
  /// [{ label, mentions }]: aspects reviewers praise, by number of reviews.
  pros          Json
  /// [{ label, mentions }]: aspects reviewers complain about.
  cons          Json
  reviewCount   Int      @map("review_count")
  averageRating Float    @map("average_rating")
  positivePct   Int      @map("positive_pct")
  /// "local" or the Claude model that wrote the summary sentence.
  model         String
  /// Hash of the reviews it was built from; skips work when nothing changed.
  inputHash     String   @map("input_hash")
  generatedAt   DateTime @default(now()) @map("generated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("review_insights")
}

// ─────────────────────────── Marketplace (Phase 7) ───────────────────────────

enum BusinessType {
  INDIVIDUAL
  LLC
  CORPORATION
  PARTNERSHIP
  NONPROFIT
}

enum SellerStatus {
  /// Applied; not yet approved by staff.
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerMemberRole {
  OWNER
  STAFF
}

/// A business selling on NIXZORA (ADR-0012).
/// The person operating a store, from the application (p8-13). Private: shown to staff for
/// review, never on the store. The date of birth is encrypted at rest.
model SellerOwner {
  sellerId         String   @id @map("seller_id") @db.Uuid
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  dateOfBirthEnc   String   @map("date_of_birth_enc")
  phone            String
  /// ISO 3166-1 alpha-2
  residenceCountry String   @default("US") @map("residence_country") @db.Char(2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_owners")
}

/// An unfinished seller application ("Save & continue later"); deleted when it is submitted.
model SellerApplicationDraft {
  userId    String   @id @map("user_id") @db.Uuid
  step      Int      @default(1)
  completed String[] @default([])
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_application_drafts")
}

model Seller {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Public storefront address: /s/<handle>
  handle           String       @unique
  displayName      String       @map("display_name")
  legalName        String       @map("legal_name")
  /// Where NIXZORA contacts the seller (orders, payouts, policy).
  contactEmail     String       @map("contact_email")
  /// ISO 3166-1 alpha-2
  country          String       @default("US") @db.Char(2)
  description      String?
  status           SellerStatus @default(PENDING)
  statusReason     String?      @map("status_reason")
  /// "FAKE" or "STRIPE"; the connected account that receives payouts.
  payoutProvider   String?      @map("payout_provider")
  payoutAccountId  String?      @unique @map("payout_account_id")
  /// Mirrors the provider: identity and bank details submitted, payouts switched on.
  detailsSubmitted Boolean      @default(false) @map("details_submitted")
  payoutsEnabled   Boolean      @default(false) @map("payouts_enabled")
  /// What the provider still needs, e.g. ["external_account", "individual.id_number"].
  requirementsDue  String[]     @default([]) @map("requirements_due")
  /// Marketplace commission in basis points (1200 = 12%).
  commissionBps    Int          @default(1200) @map("commission_bps")
  /// Days earnings are held before payout; longer for new sellers.
  payoutHoldDays   Int          @default(14) @map("payout_hold_days")
  /// Running totals of customer ratings (p7-07), kept with each rating so pages need no aggregate.
  ratingCount      Int          @default(0) @map("rating_count")
  ratingTotal      Int          @default(0) @map("rating_total")
  approvedAt       DateTime?    @map("approved_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // ── Onboarding (p8-13); null for stores that applied before it ──
  businessType         BusinessType? @map("business_type")
  /// One of SELLER_CATEGORIES.
  category             String?
  /// Private: what the store sells, in the applicant's words, for review.
  whatYouSell          String?       @map("what_you_sell")
  website              String?
  logoKey              String?       @map("logo_key")
  bannerKey            String?       @map("banner_key")
  /// Public customer support contact.
  supportEmail         String?       @map("support_email")
  supportPhone         String?       @map("support_phone")
  /// Private business address.
  addressLine1         String?       @map("address_line1")
  addressLine2         String?       @map("address_line2")
  addressCity          String?       @map("address_city")
  addressRegion        String?       @map("address_region")
  addressPostalCode    String?       @map("address_postal_code")
  /// Business days to hand an order to the carrier.
  handlingDays         Int           @default(2) @map("handling_days")
  carriers             String[]      @default([])
  shipRegions          String[]      @default(["US_CONTIGUOUS"]) @map("ship_regions")
  agreementsAcceptedAt DateTime?     @map("agreements_accepted_at")
  /// Fraud review (ADR-0024): no payouts, automatic or manual, until staff clear it.
  payoutsHeld          Boolean       @default(false) @map("payouts_held")

  members         SellerMember[]
  riskAssessments RiskAssessment[]
  owner           SellerOwner?
  products        Product[]
  orderItems      OrderItem[]
  orders          SellerOrder[]
  ledger          SellerLedgerEntry[]
  payouts         Payout[]
  ratings         SellerRating[]

  @@index([status, createdAt])
  @@map("sellers")
}

/// Who can act for a seller. A user belongs to at most one seller.
model SellerMember {
  sellerId  String           @map("seller_id") @db.Uuid
  userId    String           @unique @map("user_id") @db.Uuid
  role      SellerMemberRole @default(OWNER)
  createdAt DateTime         @default(now()) @map("created_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sellerId, userId])
  @@map("seller_members")
}

enum SellerOrderStatus {
  /// Paid; the seller still has to ship.
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/// One seller's part of a customer order (p7-05): what they ship and what they earn.
model SellerOrder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  sellerId           String            @map("seller_id") @db.Uuid
  status             SellerOrderStatus @default(PAID)
  /// The seller's items at the prices paid (before order-level coupons, which NIXZORA funds).
  itemsCents         Int               @map("items_cents")
  /// The seller's share of the shipping the customer paid, passed through without commission.
  shippingCents      Int               @map("shipping_cents")
  /// Commission rate when the order was paid, in basis points.
  commissionBps      Int               @map("commission_bps")
  commissionCents    Int               @map("commission_cents")
  /// itemsCents + shippingCents - commissionCents
  netCents           Int               @map("net_cents")
  /// Customer refunds attributed to this seller's items.
  refundedCents      Int               @default(0) @map("refunded_cents")
  trackingCarrier    String?           @map("tracking_carrier")
  trackingNumber     String?           @map("tracking_number")
  shippedAt          DateTime?         @map("shipped_at")
  /// First carrier scan of the seller's tracking number; earnings stay held until then (p9-05).
  trackingVerifiedAt DateTime?         @map("tracking_verified_at")
  deliveredAt        DateTime?         @map("delivered_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  order  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  ledger SellerLedgerEntry[]
  rating SellerRating?

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@map("seller_orders")
}

/// A customer's 1–5 rating of one delivered seller shipment (p7-07). The comment is private:
/// only the seller and staff see it.
model SellerRating {
  id            String   @id @default(uuid(7)) @db.Uuid
  sellerOrderId String   @unique @map("seller_order_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@map("seller_ratings")
}

enum SellerLedgerType {
  /// Net earnings of a shipped seller order.
  SALE
  /// A customer refund: the refunded amount minus the commission returned.
  REFUND
  /// Money sent to the seller's bank (p7-06).
  PAYOUT
  /// Manual or automatic correction.
  ADJUSTMENT
}

/// Append-only earnings ledger (ADR-0013): a seller's balance is the sum of its entries.
model SellerLedgerEntry {
  id             String           @id @default(uuid(7)) @db.Uuid
  sellerId       String           @map("seller_id") @db.Uuid
  sellerOrderId  String?          @map("seller_order_id") @db.Uuid
  type           SellerLedgerType
  /// Positive credits the seller, negative debits.
  amountCents    Int              @map("amount_cents")
  /// When the money can be paid out (sales are held for the seller's hold period).
  availableAt    DateTime         @map("available_at")
  description    String
  /// Makes each entry happen once, e.g. "sale:<sellerOrderId>".
  idempotencyKey String           @unique @map("idempotency_key")
  /// The payout this entry pays out or reverses.
  payoutId       String?          @map("payout_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  seller      Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  payout      Payout?      @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([sellerId, availableAt])
  @@index([sellerOrderId])
  @@index([payoutId])
  @@map("seller_ledger_entries")
}

enum PayoutStatus {
  /// Debited from the balance; the transfer is being sent.
  PENDING
  PAID
  /// The transfer failed; the amount went back to the balance.
  FAILED
}

/// Money sent from NIXZORA to a seller's connected account (p7-06, ADR-0014).
model Payout {
  id                 String       @id @default(uuid(7)) @db.Uuid
  sellerId           String       @map("seller_id") @db.Uuid
  amountCents        Int          @map("amount_cents")
  currency           String       @default("USD") @db.Char(3)
  status             PayoutStatus @default(PENDING)
  /// "FAKE" or "STRIPE"
  provider           String
  providerTransferId String?      @unique @map("provider_transfer_id")
  failureReason      String?      @map("failure_reason")
  /// Staff member who sent it; null for the automatic daily run.
  requestedBy        String?      @map("requested_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  paidAt             DateTime?    @map("paid_at")

  seller Seller              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  ledger SellerLedgerEntry[]

  @@index([sellerId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// Fraud signals (ADR-0024)
enum RiskSubject {
  CHECKOUT
  PAYOUT
  CHARGEBACK
}

enum RiskDecision {
  ALLOW
  REVIEW
  BLOCK
}

enum RiskReviewStatus {
  OPEN
  CLEARED
  CONFIRMED
}

/// One scored decision: a checkout, a payout, or a chargeback. Signals are [{ code, points, detail }].
model RiskAssessment {
  id           String            @id @default(uuid(7)) @db.Uuid
  subject      RiskSubject
  orderId      String?           @map("order_id") @db.Uuid
  sellerId     String?           @map("seller_id") @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  email        String?
  ipAddress    String?           @map("ip_address")
  amountCents  Int?              @map("amount_cents")
  score        Int
  decision     RiskDecision
  signals      Json
  /// Enforced, or only recorded (RISK_CHECKS=shadow).
  enforced     Boolean           @default(true)
  status       RiskReviewStatus?
  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?         @map("reviewed_at")
  reviewNote   String?           @map("review_note")
  createdAt    DateTime          @default(now()) @map("created_at")

  order      Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller     Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("RiskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([sellerId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
  @@map("risk_assessments")
}
