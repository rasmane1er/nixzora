{
  "name": "@nixzora/api",
  "version": "0.1.0",
  "private": true,
  "description": "NIXZORA API — NestJS modular monolith",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "start:search": "node dist/search-main.js",
    "dev:search": "prisma generate && nest start --watch --entryFile search-main",
    "start:ai": "node dist/ai-main.js",
    "dev:ai": "prisma generate && nest start --watch --entryFile ai-main",
    "start:worker": "node dist/worker-main.js",
    "dev:worker": "prisma generate && nest start --watch --entryFile worker-main",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && jest",
    "test:e2e": "prisma generate && jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "keys:generate": "node scripts/generate-keys.mjs",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "search:reindex": "node dist/cli/search-reindex.js",
    "eval:assistant": "node dist/cli/eval-assistant.js",
    "dr:verify": "node dist/cli/verify-restore.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-sesv2": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nixzora/i18n": "workspace:*",
    "@nixzora/validation": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "@simplewebauthn/server": "14.0.3",
    "aws-msk-iam-sasl-signer-js": "1.0.3",
    "dotenv": "18.0.5",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "kafkajs": "2.2.4",
    "nestjs-pino": "4.6.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@nixzora/eslint-config": "workspace:*",
    "@nixzora/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json",
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
