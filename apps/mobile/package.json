{
  "name": "@nixzora/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "NIXZORA shopping app for iOS and Android (Expo, React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web --output-dir dist-web",
    "release:first": "bash scripts/first-release.sh",
    "eas-build-post-install": "pnpm --filter \"@nixzora/mobile^...\" run build"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "0.4.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@nixzora/api-client": "workspace:*",
    "@nixzora/i18n": "workspace:*",
    "@nixzora/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.13",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@nixzora/eslint-config": "workspace:*",
    "@nixzora/tsconfig": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|@react-native-async-storage|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-.*|react-navigation|@react-navigation/.*|@nixzora/.*|@tanstack/.*|@stripe/.*|standard-navigation))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-web/"
    ]
  }
}
