{
  "name": "nixzora",
  "private": true,
  "description": "NIXZORA — AI-native commerce platform (monorepo)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @nixzora/api prisma:migrate",
    "db:studio": "pnpm --filter @nixzora/api exec prisma studio",
    "obs:up": "docker compose --profile observability up -d jaeger prometheus alertmanager grafana",
    "events:up": "docker compose --profile events up -d kafka",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "5.88.1",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
