{
  "name": "@nixzora/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the NIXZORA API, used by the mobile app (source package, no runtime dependencies)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@nixzora/validation": "workspace:*"
  },
  "devDependencies": {
    "@nixzora/eslint-config": "workspace:*",
    "@nixzora/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
