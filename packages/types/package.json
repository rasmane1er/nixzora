{
  "name": "@nixzora/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types (inferred from @nixzora/validation where possible)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nixzora/validation": "workspace:*"
  },
  "devDependencies": {
    "@nixzora/eslint-config": "workspace:*",
    "@nixzora/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
