# Copy to staging.tfvars (git-ignored).
domain_name    = "nixzora-demo.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"
image_repositories = {
  api        = "123456789012.dkr.ecr.us-east-1.amazonaws.com/nixzora/api"
  storefront = "123456789012.dkr.ecr.us-east-1.amazonaws.com/nixzora/storefront"
  admin      = "123456789012.dkr.ecr.us-east-1.amazonaws.com/nixzora/admin"
}
image_tag   = "replace-with-a-pushed-git-sha"
alarm_email = "you@example.com"
# ops_allowed_cidrs = ["203.0.113.10/32"]

# Kafka on Amazon MSK (ADR-0020): about 70 USD a month. See docs/runbooks/event-streaming.md.
# event_streaming_enabled = true

# EKS Auto Mode next to ECS (ADR-0021): about 73 USD a month plus nodes. See docs/runbooks/kubernetes.md.
# kubernetes_enabled = true

# PostgreSQL read replica for catalog reads (ADR-0022): about 15 USD a month.
# db_read_replica_enabled = true

# Prometheus metrics, SLO dashboards and alerts in AWS (ADR-0023): a few USD a month.
# managed_prometheus_enabled = true

# Sign in with Google / Apple (public ids; leave out to hide the buttons). See docs/runbooks/sign-in-with-google-apple.md.
# sign_in_client_ids = {
#   GOOGLE_WEB_CLIENT_ID     = "1234-abc.apps.googleusercontent.com"
#   GOOGLE_IOS_CLIENT_ID     = "1234-def.apps.googleusercontent.com"
#   GOOGLE_ANDROID_CLIENT_ID = "1234-ghi.apps.googleusercontent.com"
#   APPLE_SERVICES_ID        = "com.nixzora.shop.web"
# }
