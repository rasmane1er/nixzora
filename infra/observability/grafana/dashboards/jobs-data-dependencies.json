              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 100
              },
              {
                "color": "#d03b3b",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      }
    },
