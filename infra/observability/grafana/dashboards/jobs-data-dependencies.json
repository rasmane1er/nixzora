        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nixzora_outbox_backlog{queue=\"stream\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
